OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Opt out of NeMo Guardrails' anonymous usage telemetry (industry-standard
# env var: https://consoledonottrack.com/). Not required, just good hygiene
# for a demo repo.
DO_NOT_TRACK=1
